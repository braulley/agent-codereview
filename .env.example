# Obrigatória — Gemini no backend (nunca no client)
GEMINI_API_KEY=

# Opcional — ingestão de PR GitHub
GITHUB_TOKEN=

# Opcional — ingestão de MR GitLab
GITLAB_TOKEN=

# Opcional — destino do rewrite Next `/api/*` → FastAPI (só server-side em
# frontend/next.config.ts; default http://127.0.0.1:8000). Sem NEXT_PUBLIC_*.
BACKEND_URL=http://127.0.0.1:8000

